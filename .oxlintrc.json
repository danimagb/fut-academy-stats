{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "no-var": "error",
    "prefer-const": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "vitest/no-focused-tests": "error",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off"
  },
  "overrides": [
    {
      "files": ["*.config.ts", "*.config.js"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["../**", "@/app/**", "@/pages/**", "@/features/**", "@/data/**", "@/domain/**"]
          }
        ]
      }
    },
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              "../**",
              "@/app/**",
              "@/pages/**",
              "@/features/**",
              "@/data/**",
              "@/shared/ui/**",
              "@/shared/i18n/*"
            ]
          }
        ]
      }
    },
    {
      "files": ["src/data/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["../**", "@/app/**", "@/pages/**", "@/features/**"]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["../**", "@/app/**", "@/pages/**", "@/features/**"]
          }
        ]
      }
    },
    {
      "files": ["src/pages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": ["../**", "@/app/**", "@/pages/**"]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist/**", "public/vendor/**", "supabase/**"]
}
